# ---- Claude (the brain) ----
ANTHROPIC_API_KEY=sk-ant-...
# Deep analysis of the business script, rehearsal and post-call review.
ONBOARDING_MODEL=claude-opus-5
ONBOARDING_EFFORT=high
# Live conversation on the phone. Latency matters here.
CALL_MODEL=claude-opus-5
CALL_EFFORT=low
CALL_MAX_TOKENS=1024
# adaptive (recommended) = model thinks only when a turn needs it; disabled = lowest latency, slightly less reliable tool use.
CALL_THINKING=adaptive
# Fast mode (Claude API only): same model, up to 2.5x faster output, premium pricing.
CALL_FAST_MODE=false
# Natural "Mm-hm." while the model is still composing, only if the first word takes longer than this.
CALL_FILLERS=true
FILLER_DELAY_MS=700
# Server-side refusal fallbacks (Claude API only). Set false on Bedrock/Vertex/Foundry.
ENABLE_REFUSAL_FALLBACKS=true

# ---- Ears: streaming speech-to-text ----
# deepgram | soniox. Soniox identifies the language per word, which suits campaigns
# that switch between English, Arabic and French on one call.
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3-general
DEEPGRAM_ENDPOINTING_MS=300
# Used when a campaign speaks more than one language (code-switching).
DEEPGRAM_MULTILINGUAL_MODEL=nova-3
# Languages you have confirmed on your own test calls. A campaign that needs another
# language while switching will not start on Deepgram.
DEEPGRAM_MULTILINGUAL_LANGUAGES=en,es,fr,de,hi,it,ja,nl,ru,pt
SONIOX_API_KEY=
SONIOX_MODEL=stt-rt-v6

# ---- Voice: ElevenLabs ----
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional: a different voice per language on calls that switch language.
ELEVENLABS_VOICE_ID_EN=
ELEVENLABS_VOICE_ID_AR=
ELEVENLABS_VOICE_ID_FR=
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_STABILITY=0.45
ELEVENLABS_SIMILARITY=0.8
ELEVENLABS_STYLE=0.25
ELEVENLABS_SPEED=1.0

# ---- Telephony: Twilio ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15550000000
TWILIO_VALIDATE_SIGNATURE=true
# Public HTTPS URL of this server (ngrok, Cloudflare tunnel, or your domain). No trailing slash.
PUBLIC_BASE_URL=https://your-tunnel.ngrok.app
# Optional: where transfer_to_human sends the call
HUMAN_TRANSFER_NUMBER=
RECORD_CALLS=false
CALL_TIME_LIMIT_SECONDS=600

# ---- Dialer policy ----
MAX_CONCURRENT_CALLS=3
MAX_ATTEMPTS=3
RETRY_DELAY_MINUTES=240
CALLING_WINDOW_START=09:00
CALLING_WINDOW_END=19:00
DEFAULT_TIMEZONE=America/New_York
DEFAULT_PHONE_REGION=US
SECONDS_BETWEEN_DIALS=2
# What one connected minute and one dial attempt cost you across all providers
# (telephony + speech recognition + model + voice). Measure it on your own calls.
# Needed for per-call cost, campaign spend and budgets. 0 = not measured yet.
COST_PER_CONNECTED_MINUTE_USD=0
COST_PER_CALL_ATTEMPT_USD=0

# ---- Turn-taking ----
# Semantic end-of-turn detection (bundled local Smart Turn v3 model). false = plain VAD silence timeout.
USE_SMART_TURN=true
OPENER_DELAY_SECONDS=1.5
USER_IDLE_SECONDS=8

# ---- Storage / server ----
# SQLite suits one operator on one machine. For a hosted, multi-customer service use
# PostgreSQL: pip install "callagent[postgres]" and
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/callagent
DATABASE_URL=sqlite:///./callagent.db
# Connection pool for PostgreSQL (ignored by SQLite).
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# Longest wait for the telephony provider's API, in seconds.
# PROVIDER_TIMEOUT_SECONDS=15
DATA_DIR=./data
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_URL=http://localhost:8000
# Optional webhook that receives booked meetings as JSON (Zapier/Make/n8n/your CRM)
BOOKING_WEBHOOK_URL=
# Campaign (name or id) that answers inbound calls to numbers with no campaign of their own.
INBOUND_CAMPAIGN=
# Bearer token protecting /api/* (the server is public for Twilio). Leave empty to auto-generate into DATA_DIR/api_token.
API_TOKEN=
