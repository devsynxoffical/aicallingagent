# ---- Claude (the brain) ----
ANTHROPIC_API_KEY=sk-ant-...
# Deep analysis of the business script, rehearsal and post-call review.
ONBOARDING_MODEL=claude-opus-5
ONBOARDING_EFFORT=high
# Live conversation on the phone. Latency matters here, so effort is low.
CALL_MODEL=claude-opus-5
CALL_EFFORT=low
CALL_MAX_TOKENS=400
# Server-side refusal fallbacks (Claude API only). Set false on Bedrock/Vertex/Foundry.
ENABLE_REFUSAL_FALLBACKS=true

# ---- Ears: Deepgram streaming STT ----
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3-general

# ---- Voice: ElevenLabs ----
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_STABILITY=0.45
ELEVENLABS_SIMILARITY=0.8
ELEVENLABS_STYLE=0.25
ELEVENLABS_SPEED=1.0

# ---- Telephony: Twilio ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15550000000
TWILIO_VALIDATE_SIGNATURE=true
# Public HTTPS URL of this server (ngrok, Cloudflare tunnel, or your domain). No trailing slash.
PUBLIC_BASE_URL=https://your-tunnel.ngrok.app
# Optional: where transfer_to_human sends the call
HUMAN_TRANSFER_NUMBER=
RECORD_CALLS=false
CALL_TIME_LIMIT_SECONDS=600

# ---- Dialer policy ----
MAX_CONCURRENT_CALLS=3
MAX_ATTEMPTS=3
RETRY_DELAY_MINUTES=240
CALLING_WINDOW_START=09:00
CALLING_WINDOW_END=19:00
DEFAULT_TIMEZONE=America/New_York
DEFAULT_PHONE_REGION=US
SECONDS_BETWEEN_DIALS=2

# ---- Turn-taking ----
# Semantic end-of-turn detection (bundled local Smart Turn v3 model). false = plain VAD silence timeout.
USE_SMART_TURN=true
OPENER_DELAY_SECONDS=1.5
USER_IDLE_SECONDS=8

# ---- Storage / server ----
DATABASE_URL=sqlite:///./callagent.db
DATA_DIR=./data
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_URL=http://localhost:8000
# Optional webhook that receives booked meetings as JSON (Zapier/Make/n8n/your CRM)
BOOKING_WEBHOOK_URL=
